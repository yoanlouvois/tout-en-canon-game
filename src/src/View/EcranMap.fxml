                                                            <font>
                                                                <Font size="48.0" />
                                                            </font>
                                                        </Label>
                                                        <Separator prefWidth="200.0" />
                                                        <Label fx:id="labelClasseJeu" alignment="CENTER" contentDisplay="CENTER" prefHeight="50.0" prefWidth="400.0" text="Label" textFill="WHITE">
